/**
 * Bibo - Launch pi-coding-agent with web dashboard
 * Usage: bibo [prompt]
 *
 * Cross-platform launcher that:
 * 1. Shows a colorful startup banner with loading animation
 * 2. Starts the dashboard server (if not already running)
 * 3. Launches pi-coding-agent
 * 4. Cleans up the dashboard when pi exits
 */

import { spawn } from 'child_process';
import { readFileSync, writeFileSync, existsSync, unlinkSync, mkdirSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';
import { platform } from 'os';

const __dirname = dirname(fileURLToPath(import.meta.url));
const DASHBOARD_DIR = join(__dirname, '..', 'dashboard');
const SERVER_JS = join(DASHBOARD_DIR, 'src', 'server.js');
const PID_FILE = join(process.env.HOME || process.env.USERPROFILE || '.', '.pi', 'dashboard.pid');
const PORT = 3000;
const HOST = '127.0.0.1';

// --- ANSI Color helpers ---
const isWindows = platform() === 'win32';
const _C = {
  reset:   '\x1b[0m',
  bold:    '\x1b[1m',
  dim:     '\x1b[2m',
  cyan:    '\x1b[36m',
  green:   '\x1b[32m',
  yellow:  '\x1b[33m',
  red:     '\x1b[31m',
  magenta: '\x1b[35m',
  blue:    '\x1b[34m',
  white:   '\x1b[37m',
};

function c(color, text) {
  if (isWindows) return text;
  return `${_C[color] || ''}${text}${_C.reset}`;
}

// --- ASCII Art Banner with Mascot ---
const BANNER = [
  c('dim', '  ┌──────┐'),
  c('dim', '  │') + c('cyan', '●   ●') + c('dim', ' │'),
  c('dim', '  └──────┘'),
  c('bold', c('magenta', '  BIBO')),
].join('\n');

// --- Compact Icon (for prompts, small displays) ---
const ICON = [
  c('cyan', '┌──┐'),
  c('cyan', '│') + c('white', '◠◠') + c('cyan', '│'),
  c('cyan', '└┬─┘'),
  c('magenta', ' BIBO'),
].join('\n');

// --- Single multi-label loading bar ---
// Sized to fit within the BIBO logo width
const BAR_WIDTH = 22;
const BAR_INDENT = ' ';

function showLoading(labels, totalDuration = 1900) {
  return new Promise((resolve) => {
    const steps = 40;
    const interval = totalDuration / steps;
    let i = 0;

    const frame = () => {
      i++;
      const label = labels[Math.min(Math.floor((i / steps) * labels.length), labels.length - 1)];
      const filled = Math.round((i / steps) * BAR_WIDTH);
      const unfilled = BAR_WIDTH - filled;
      const bar = c('cyan', '█'.repeat(filled)) + c('dim', '·'.repeat(unfilled));

      if (i >= steps) {
        process.stdout.write(`\r${BAR_INDENT}${c('green', '█'.repeat(BAR_WIDTH))}  \n`);
        process.stdout.write(`\r${BAR_INDENT}${c('green', '✔')} ${c('dim', 'ready')}               \n`);
        clearInterval(timer);
        resolve();
        return;
      }

      // Print bar on current line, label on next line, then move cursor back up
      process.stdout.write(
        `\r${BAR_INDENT}[${bar}]\n` +
        `\r${BAR_INDENT}${c('dim', '⚡')} ${c('dim', label)}               ` +
        `\x1b[1A`
      );
    };

    // Reserve the second line so cursor-up works from the first tick
    process.stdout.write('\n');
    const timer = setInterval(frame, interval);
    frame();
  });
}

// --- Splash Screen ---
async function showStartupScreen() {
  process.stdout.write('\n\n' + BANNER + '\n\n\n');

  await showLoading(['Initializing model', 'Connecting to provider', 'Preparing context']);
}

// --- Ensure .pi directory exists ---
const piDir = join(process.env.HOME || process.env.USERPROFILE || '.', '.pi');
if (!existsSync(piDir)) {
  mkdirSync(piDir, { recursive: true });
}

function getDashboardPid() {
  if (!existsSync(PID_FILE)) return null;
  try {
    return parseInt(readFileSync(PID_FILE, 'utf8').trim(), 10);
  } catch {
    return null;
  }
}

function isProcessRunning(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

async function startDashboard() {
  const child = spawn('node', [SERVER_JS], {
    detached: true,
    stdio: 'ignore',
    env: { ...process.env, PORT: String(PORT), HOST }
  });

  child.unref();
  writeFileSync(PID_FILE, String(child.pid));
  return child;
}

function stopDashboard() {
  const pid = getDashboardPid();
  if (!pid) return;

  if (isProcessRunning(pid)) {
    try {
      process.kill(pid, 'SIGTERM');
    } catch {
      // Process already died, that's fine
    }
  }
  try {
    unlinkSync(PID_FILE);
  } catch {
    // PID file already removed, that's fine
  }
}

// --- Cleanup (guarded against re-entrancy) ---
let cleaningUp = false;

function cleanup() {
  if (cleaningUp) return;
  cleaningUp = true;
  stopDashboard();
}

// 'exit' handler must NOT call process.exit() — it would recurse
process.on('exit', cleanup);

// Signal handlers call cleanup then exit
process.on('SIGINT',  () => { cleanup(); process.exit(0); });
process.on('SIGTERM', () => { cleanup(); process.exit(0); });

// --- Main ---
async function main() {
  await showStartupScreen();

  // Start dashboard if not already running
  let dashboardPid = getDashboardPid();
  if (dashboardPid && isProcessRunning(dashboardPid)) {
    process.stdout.write(`  ${c('dim', 'Dashboard')} ${c('green', '✓')} ${c('dim', 'already running (PID ' + dashboardPid + ')')}\n`);
  } else {
    if (dashboardPid) {
      try { unlinkSync(PID_FILE); } catch {}
    }
    await startDashboard();
  }

  // Resolve pi binary path
  const PI_BIN = join(__dirname, '..', 'node_modules', '.bin', 'pi');

  if (!existsSync(PI_BIN)) {
    process.stdout.write(`\n${c('red', '  ✘ Error:')} pi-coding-agent not found. Run \`npm install\` in ~/bibo first.\n\n`);
    process.exit(1);
  }

  process.stdout.write(`\n${c('dim', '  ' + '─'.repeat(50))}\n`);

  const piProcess = spawn(PI_BIN, process.argv.slice(2), {
    stdio: 'inherit',
    env: { ...process.env }
  });

  piProcess.on('close', (code) => {
    cleanup();
    process.exit(code ?? 0);
  });

  piProcess.on('error', (err) => {
    process.stdout.write(`\n${c('red', '  ✘ Failed to start pi:')} ${err.message}\n\n`);
    cleanup();
    process.exit(1);
  });
}

main().catch((err) => {
  console.error('Fatal:', err);
  cleanup();
  process.exit(1);
});
