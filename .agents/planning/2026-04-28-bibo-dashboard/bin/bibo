#!/usr/bin/env bash
# Bibo - Launch pi-coding-agent with web dashboard
# Usage: bibo [prompt]
# The dashboard runs in the background and stops when pi exits.

set -e

# Resolve paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DASHBOARD_DIR="$(dirname "$SCRIPT_DIR")"
SERVER_JS="$DASHBOARD_DIR/src/server.js"
PID_FILE="$HOME/.pi/dashboard.pid"

# Start dashboard if not already running
if [ -f "$PID_FILE" ]; then
    DASHBOARD_PID=$(cat "$PID_FILE")
    if kill -0 "$DASHBOARD_PID" 2>/dev/null; then
        echo "Dashboard already running (PID $DASHBOARD_PID)"
    else
        rm -f "$PID_FILE"
        # Start dashboard
        echo "Starting dashboard..."
        node "$SERVER_JS" &
        DASHBOARD_PID=$!
        echo "$DASHBOARD_PID" > "$PID_FILE"
        echo "Dashboard started (PID $DASHBOARD_PID)"
    fi
else
    # Start dashboard
    echo "Starting dashboard..."
    node "$SERVER_JS" &
    DASHBOARD_PID=$!
    echo "$DASHBOARD_PID" > "$PID_FILE"
    echo "Dashboard started (PID $DASHBOARD_PID)"
fi

# Clean up dashboard when pi exits
cleanup() {
    echo "Stopping dashboard..."
    if [ -f "$PID_FILE" ]; then
        DASHBOARD_PID=$(cat "$PID_FILE")
        if kill -0 "$DASHBOARD_PID" 2>/dev/null; then
            kill "$DASHBOARD_PID" 2>/dev/null || true
            wait "$DASHBOARD_PID" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
        echo "Dashboard stopped."
    fi
}

# Trap exit signals to clean up dashboard
trap cleanup EXIT INT TERM

# Launch pi-coding-agent with optional prompt
if [ $# -gt 0 ]; then
    echo "Launching pi with prompt: $*"
    exec node ~/kibi/node_modules/.bin/pi "$@"
else
    echo "Launching pi..."
    exec node ~/kibi/node_modules/.bin/pi
fi
